{
  "name": "dnd5e-toolkit",
  "private": true,
  "version": "0.1.1",
  "description": "Desktop D&D 5e DM toolkit for encounter prep, initiative, SRD lookup, notes, maps, music, soundboard, and player display.",
  "author": "Carlos B. Gómez García",
  "license": "MIT",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "tsc -p tsconfig.electron.json && concurrently \"vite\" \"wait-on tcp:5173 && electron .\"",
    "build": "tsc -b && vite build",
    "build:electron": "vite build && tsc -p tsconfig.electron.json",
    "dist:win": "npm run build:electron && electron-builder --win --config.directories.output=%TEMP%\\\\df-dmtoolkit-release",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource/alegreya": "^5.2.8",
    "@fontsource/alegreya-sans": "^5.2.8",
    "@fontsource/marcellus": "^5.2.8",
    "@tanstack/react-virtual": "^3.14.5",
    "electron-updater": "^6.8.9",
    "immer": "^10.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.9.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.3",
    "vitest": "^4.1.10",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.dnd5e.toolkit",
    "productName": "DnD5e DMToolkit",
    "copyright": "Copyright © 2026 Carlos B. Gómez García",
    "publish": [
      {
        "provider": "github",
        "owner": "Vueko",
        "repo": "DF-DMToolkit"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "artifactName": "DnD5e DMToolkit.exe",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
