{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "lib": ["ES2022"],
    "rootDir": "electron",
    "outDir": "dist-electron",
    "types": ["node"],
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true
  },
  "include": ["electron/**/*"],
  "exclude": ["**/*.test.ts"]
}